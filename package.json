{
  "name": "node-wasm-vercel-api",
  "version": "1.0.0",
  "description": "Node.js + TypeScript + C++ (WASM) API website deployed on Vercel",
  "private": true,
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/node": "^5.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.6.3",
    "vercel": "^43.0.0"
  }
}
