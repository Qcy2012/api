{
  "name": "node-cpp-vercel-api",
  "version": "1.0.0",
  "description": "Node.js + TypeScript + C++ N-API API deployed on Vercel",
  "type": "module",
  "main": "dist/api/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch & vercel dev",
    "start": "vercel dev",
    "rebuild": "node-gyp rebuild",
    "configure": "node-gyp configure",
    "compile": "node-gyp build",
    "clean": "node-gyp clean",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@vercel/node": "^3.2.0",
    "node-addon-api": "^8.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vercel": "^34.0.0"
  },
  "gypfile": true,
  "engines": {
    "node": ">=18.x"
  }
}
