{
  "name": "API-Server",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --experimental-wasi-unstable-preview1 -r ts-node/register src/server.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:webp": "node scripts/build-wasm.mjs --webp",
    "typecheck": "tsc --noEmit",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "express": "^4.18.2" 
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vercel": "^32.0.0"
  }
}