{
  "name": "node-wasm-vercel-api",
  "version": "1.0.0",
  "description": "Node.js + C++/WASM API site, deploy to Vercel without VS or gyp",
  "engines": { "node": "22.x" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vercel dev",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@vercel/node": "^5.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.6.3",
    "vercel": "^43.0.0"
  }
}
